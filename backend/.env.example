# Copy to .env for local development. NEVER commit .env. On Render, set these in the dashboard instead.
APP_NAME=ContribMatch API
APP_VERSION=0.1.0
ENVIRONMENT=development          # use "production" when deployed
DEBUG=false
LOG_LEVEL=INFO

# ---- CORS ---------------------------------------------------------------------------------------------
# Comma-separated list of exact frontend origins (scheme + host, no path). In production this must be your
# Vercel URL, e.g. https://contribmatch.vercel.app (a trailing slash is tolerated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for origins you cannot list (for example every Vercel preview URL). Leave empty unless
# needed; a broad pattern lets ANY matching site call your API from a browser.
CORS_ORIGIN_REGEX=

# ---- Database -------------------------------------------------------------------------------------------
# Local development (default): SQLite file; relative paths resolve from backend/.
DATABASE_URL=sqlite:///./data/contribmatch.db
# Production (Neon PostgreSQL). Paste the *pooled* connection string from the Neon console. Both
# postgresql:// and postgres:// are accepted and use the psycopg driver automatically. This is a SECRET.
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Tables are created automatically on first use. Pool settings apply to PostgreSQL only.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=300
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10

# ---- GitHub (backend only; never put this in the frontend) ----------------------------------------------
# Personal access token for PUBLIC data (no scopes needed). Optional but strongly recommended: it raises
# search from 10 to 30 requests/min and core API calls from 60 to 5000/hour.
GITHUB_TOKEN=

GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=10
GITHUB_MAX_RETRIES=2
GITHUB_RETRY_BACKOFF_SECONDS=0.5
GITHUB_SEARCH_CACHE_TTL_SECONDS=600
GITHUB_REPO_CACHE_TTL_SECONDS=86400
GITHUB_REPO_CONCURRENCY=5

# ---- Embedding model (pretrained, not trained by this project) ------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_MAX_ITEMS=5000
# Where model files are cached on disk. Empty = the default Hugging Face cache. The Render build downloads
# the model into this folder (relative paths resolve from backend/) so the first request does not have to.
MODEL_CACHE_DIR=

# ---- Recommendation workflow ----------------------------------------------------------------------------
# false = the model is loaded into memory lazily, on the first recommendation request (default).
PRELOAD_MODEL=false
MAX_SEARCH_QUERIES=3
CANDIDATES_PER_QUERY=30
